# =============================================================================
# Скопируй этот файл в .env и заполни значения
# cp .env.example .env
#
# .env никогда не попадает в GitHub (он в .gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# Grant Architect Bot
# Получить у @BotFather → /newbot
# ---------------------------------------------------------------------------
TG_BOT_TOKEN=

# ---------------------------------------------------------------------------
# IGI Bot (Meaning Tunnel / Idea → Get Income)
# Получить у @BotFather → /newbot
# ---------------------------------------------------------------------------
IGI_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Liya AI Bot — продающая воронка до стратегической сессии
# ---------------------------------------------------------------------------
LIA_BOT_TOKEN=

# Кодовое слово для входа в воронку (по умолчанию: AI)
CODE_WORD=AI

# Ссылка на продающее видео (Loom / YouTube / любая ссылка)
# Если пусто — бот пропустит шаг с видео
SALES_VIDEO_URL=

# Ссылка на запись в Google Calendar / Calendly
CALENDAR_LINK=

# Твой личный Telegram chat_id — чтобы получать уведомления о лидах
# Узнать свой chat_id: напиши боту @userinfobot
ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# GitHub — для хранения файлов курса (Grant Architect Bot)
# Получить: github.com/settings/tokens → Generate new token (classic)
# Права: Contents (read + write)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=podobowopl-collab
GITHUB_REPO=GRANT-AGENT-COURSE

# ---------------------------------------------------------------------------
# Порт (оставь как есть)
# ---------------------------------------------------------------------------
PORT=8080
